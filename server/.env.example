# 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 배포·공유하지 마세요)
HOST=
PORT=
# 정비 전산 흉내 화면 포트(기본 PORT+1). 항상 127.0.0.1 에만 열립니다. 프록시·터널로 넘기지 마세요.
ADMIN_PORT=
# 클라우드(Render 등) 시험용. 값을 넣으면 화면(/)과 /api/* 를 POS 포트에도 열고 HTTP Basic 인증(사용자 이름 아무거나, 비밀번호 = 이 값)을 겁니다.
# 12자 이상. 비우면 위의 ADMIN_PORT(127.0.0.1)에서만 열립니다.
ADMIN_PASSWORD=
# 클라우드 시험용. data/shops.json 이 없을 때 이 토큰(24자 이상)으로 시험 매장을 만듭니다(콘솔에 출력하지 않음). 비우면 무작위 토큰을 만들어 한 번 출력합니다.
SHOP_TOKEN=
# SHOP_TOKEN 으로 만드는 매장의 이름(선택, 기본 "시험 매장")
SHOP_NAME=
TOSS_WEBHOOK_SECRET=
TOSS_OPENAPI_ACCESS_KEY=
TOSS_OPENAPI_SECRET_KEY=
TOSS_OPENAPI_BASE_URL=
